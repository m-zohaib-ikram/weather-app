<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#FFD700"
                android:layout_marginBottom="15dp"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="30dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_name_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Full Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textPersonName" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_email_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Email Address"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textEmailAddress" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_country_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Country"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textCapWords" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_province_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Province / State"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textCapWords" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_district_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="District"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textCapWords" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_city_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="City"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textCapWords" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_password_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textPassword" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">
                <EditText
                    android:id="@+id/signup_confirm_password_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Confirm Password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#CCFFFFFF"
                    android:paddingStart="20dp"
                    android:inputType="textPassword" />
            </androidx.cardview.widget.CardView>

            <CheckBox
                android:id="@+id/robot_verify_cb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I am not a robot"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:buttonTint="#FFD700"
                android:layout_marginBottom="25dp"/>

            <Button
                android:id="@+id/signup_btn"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="SIGN UP"
                android:textColor="#121212"
                android:textStyle="bold"
                android:backgroundTint="#FFD700"
                app:cornerRadius="15dp"/>

            <TextView
                android:id="@+id/go_to_login_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Login"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>